set -o pipefail
shopt -s nullglob

ENV_FILE="/etc/mysql_backup.env"
LOCK_FILE="/var/lock/mysql_backup.lock"
ONLY_DB=""
OLD_DIRS=()

usage() {
  cat <<EOF
Usage: mysql_backup [OPTIONS]

Reliable MySQL backup automation with multi-destination uploads (FTP / FTPS / SFTP),
AES-256 GPG encryption, and Telegram notifications.

Options:
  --only-db=DBNAME      Backup only the specified database instead of all databases.
                       Useful for quick debugging or testing a single database.
  -h, --help          Show this help message and exit.

Config:
  Reads settings from: ${ENV_FILE}
  (backup dir, MySQL credentials, retention days, encryption, upload
   destinations, Telegram bot token/chat IDs, Telegram proxy, etc.)

Examples:
  mysql_backup                       # backup all databases as configured
  mysql_backup --only-db=myapp_prod  # backup only "myapp_prod"

Log file location:
  \$BACKUP_BASE_DIR/YYYY-MM-DD/backup_YYYY-MM-DD.log

Project: https://github.com/benyaminmansourian/auto-mysql-backup
License: MIT
EOF
}

for arg in "$@"; do
  case $arg in
    --only-db=*)
      ONLY_DB="${arg#*=}"
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "❌ Unknown option: $arg"
      echo ""
      usage
      exit 1
      ;;
  esac
done

if [ ! -f "$ENV_FILE" ]; then
  echo "❌ Config file not found at $ENV_FILE"
  exit 1
fi

source "$ENV_FILE"

exec 200>"$LOCK_FILE"
if ! flock -n 200; then
  echo "⚠️ Another instance of mysql_backup is already running. Exiting."
  exit 1
fi

START_TIME=$(date +%s)
DATE=$(date +%Y-%m-%d)
DATETIME_DISPLAY=$(date '+%Y-%m-%d %H:%M')
BACKUP_DIR="$BACKUP_BASE_DIR/$DATE"
LOG_FILE="$BACKUP_DIR/backup_${DATE}.log"

mkdir -p "$BACKUP_DIR"

MYSQL=${MYSQL_PATH:-/usr/bin/mysql}
MYSQLDUMP=${MYSQLDUMP_PATH:-/usr/bin/mysqldump}

FAILED_TARGETS=()

log() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') $1" | tee -a "$LOG_FILE"
}

TG_PROXY_ARGS=()
build_telegram_proxy_args() {
  TG_PROXY_ARGS=()
  if [ "$TELEGRAM_PROXY_ENABLED" = "true" ] && [ -n "$TELEGRAM_PROXY_ADDR" ]; then
    local scheme="${TELEGRAM_PROXY_TYPE:-socks5h}"
    [ "$scheme" = "socks5" ] && scheme="socks5h"
    TG_PROXY_ARGS+=(--proxy "${scheme}://${TELEGRAM_PROXY_ADDR}")
    if [ -n "$TELEGRAM_PROXY_USER" ]; then
      TG_PROXY_ARGS+=(--proxy-user "${TELEGRAM_PROXY_USER}:${TELEGRAM_PROXY_PASS}")
    fi
  fi
}
build_telegram_proxy_args

send_telegram_message() {
  [ "$TELEGRAM_ENABLED" = "true" ] || return 0
  local MESSAGE
  MESSAGE=$(echo -e "$1")

  if [ ${#TELEGRAM_CHAT_IDS[@]} -gt 0 ]; then
    for CHAT_ID in "${TELEGRAM_CHAT_IDS[@]}"; do
      curl -s "${TG_PROXY_ARGS[@]}" -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
        -d chat_id="$CHAT_ID" -d parse_mode="HTML" \
        --data-urlencode "text=$MESSAGE" >/dev/null 2>&1
    done
  elif [ -n "$TELEGRAM_CHAT_ID" ]; then
    curl -s "${TG_PROXY_ARGS[@]}" -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
      -d chat_id="$TELEGRAM_CHAT_ID" -d parse_mode="HTML" \
      --data-urlencode "text=$MESSAGE" >/dev/null 2>&1
  fi
}

send_telegram_file() {
  [ "$TELEGRAM_ENABLED" = "true" ] || return 0
  [ -f "$LOG_FILE" ] || return 0
  local CAPTION
  CAPTION=$(echo -e "$1")

  if [ ${#TELEGRAM_CHAT_IDS[@]} -gt 0 ]; then
    for CHAT_ID in "${TELEGRAM_CHAT_IDS[@]}"; do
      curl -s "${TG_PROXY_ARGS[@]}" -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendDocument" \
        -F chat_id="$CHAT_ID" -F document=@"$LOG_FILE" -F parse_mode="HTML" \
        --form-string "caption=$CAPTION" >/dev/null 2>&1
    done
  elif [ -n "$TELEGRAM_CHAT_ID" ]; then
    curl -s "${TG_PROXY_ARGS[@]}" -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendDocument" \
      -F chat_id="$TELEGRAM_CHAT_ID" -F document=@"$LOG_FILE" -F parse_mode="HTML" \
      --form-string "caption=$CAPTION" >/dev/null 2>&1
  fi
}

log "=== Starting MySQL backup ==="
[ -n "$ONLY_DB" ] && log "🎯 Running in single-db mode: $ONLY_DB"
send_telegram_message "📦 <b>MySQL Backup Started</b>\n🖥️ Host: $(hostname)\n📅 Date: $DATETIME_DISPLAY"

if [ "$USE_PASSWORD" = "true" ]; then
  AUTH_ARGS=(-u"$MYSQL_USER" -p"$MYSQL_PASSWORD")
else
  AUTH_ARGS=(-u"$MYSQL_USER")
fi

if ! "$MYSQL" "${AUTH_ARGS[@]}" -e "SELECT 1;" >/dev/null 2>&1; then
  log "❌ Cannot connect to MySQL server. Check credentials/socket. Aborting."
  send_telegram_message "🚨 <b>MySQL Backup Aborted</b>\n🖥️ Host: $(hostname)\nReason: cannot connect to MySQL"
  wait
  exit 1
fi

if [ -n "$ONLY_DB" ]; then
  databases="$ONLY_DB"
else
  databases=$("$MYSQL" "${AUTH_ARGS[@]}" -e "SHOW DATABASES;" | grep -Ev "(Database|information_schema|performance_schema|mysql|sys)")
fi

ERROR_COUNT=0
ERROR_LOG=""

for db in $databases; do
  log "Backing up: $db"
  ERROR_OUTPUT=$(mktemp)
  OUT_FILE="$BACKUP_DIR/$db.sql.gz"

  "$MYSQLDUMP" "${AUTH_ARGS[@]}" --force --opt --databases "$db" 2> "$ERROR_OUTPUT" | gzip > "$OUT_FILE"
  EXIT_CODE=${PIPESTATUS[0]}

  if [ "$EXIT_CODE" -ne 0 ]; then
    log "❌ Backup failed for $db (mysqldump exit code: $EXIT_CODE)"
    ERROR_COUNT=$((ERROR_COUNT + 1))
    ERR_TEXT=$(tail -n 5 "$ERROR_OUTPUT")
    ERROR_LOG+="❌ <b>$db</b> → ${ERR_TEXT}\n"
    rm -f "$OUT_FILE"
  else
    if gzip -t "$OUT_FILE" 2>/dev/null; then
      log "✅ Backup success for $db ($(du -h "$OUT_FILE" | cut -f1))"
    else
      log "❌ Integrity check failed for $db.sql.gz (corrupt archive)"
      ERROR_COUNT=$((ERROR_COUNT + 1))
      ERROR_LOG+="❌ <b>$db</b> → corrupt archive after gzip -t\n"
      rm -f "$OUT_FILE"
    fi
  fi

  rm -f "$ERROR_OUTPUT"
done

encrypt_backups() {
  log "Encrypting backups using AES-256 GPG encryption..."
  for file in "$BACKUP_DIR"/*.gz; do
    if echo "$GPG_PASSWORD" | gpg --batch --yes --pinentry-mode loopback --passphrase-fd 0 \
      --symmetric --cipher-algo AES256 "$file"; then
      log "✅ Encrypted: $(basename "$file")"
      rm -f "$file"
    else
      log "❌ Encryption failed for $(basename "$file")"
      ERROR_COUNT=$((ERROR_COUNT + 1))
      ERROR_LOG+="❌ <b>$(basename "$file")</b> → encryption failed, plaintext kept\n"
    fi
  done
}

if [ "$ENCRYPT_BACKUPS" = "true" ]; then
  encrypt_backups
else
  log "Encryption disabled"
fi

cleanup_local() {
  log "Deleting local backups older than $RETENTION_DAYS days (by folder name)..."
  local cutoff dname dir
  cutoff=$(date -d "-$RETENTION_DAYS days" +%Y-%m-%d)

  for dir in "$BACKUP_BASE_DIR"/*/; do
    dname=$(basename "$dir")
    if [[ "$dname" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] && [[ "$dname" < "$cutoff" ]]; then
      OLD_DIRS+=("$dname")
      rm -rf "$dir"
      log "🗑️ Removed local dir: $dname"
    fi
  done
}

cleanup_remote_ftp_family() {
  local -n destinations=$1
  local scheme=$2
  local dest host user pass path old_dir

  [ "${#destinations[@]}" -eq 0 ] && return
  [ "${#OLD_DIRS[@]}" -eq 0 ] && return
  if ! command -v lftp >/dev/null 2>&1; then
    log "⚠️ lftp not installed, skipping remote $scheme cleanup"
    return
  fi

  for dest in "${destinations[@]}"; do
    IFS='|' read -r host user pass path <<< "$dest"
    for old_dir in "${OLD_DIRS[@]}"; do
      if lftp -u "$user,$pass" "${scheme}://$host" -e "rm -rf $path/$old_dir; bye" >/dev/null 2>&1; then
        log "🗑️ Removed remote ($scheme) $host:$path/$old_dir"
      else
        log "⚠️ Could not remove remote ($scheme) $host:$path/$old_dir (may not exist)"
      fi
    done
  done
}

cleanup_remote_sftp() {
  local dest host user pass path old_dir

  [ "${#SFTP_DESTINATIONS[@]}" -eq 0 ] && return
  [ "${#OLD_DIRS[@]}" -eq 0 ] && return

  for dest in "${SFTP_DESTINATIONS[@]}"; do
    IFS='|' read -r host user pass path <<< "$dest"
    for old_dir in "${OLD_DIRS[@]}"; do
      if sshpass -p "$pass" ssh -o StrictHostKeyChecking=no "$user@$host" "rm -rf '$path/$old_dir'" >/dev/null 2>&1; then
        log "🗑️ Removed remote (SFTP) $host:$path/$old_dir"
      else
        log "⚠️ Could not remove remote (SFTP) $host:$path/$old_dir (may not exist)"
      fi
    done
  done
}

cleanup_local

if [ "$UPLOAD_ENABLED" = "true" ]; then
  cleanup_remote_ftp_family FTP_DESTINATIONS ftp
  cleanup_remote_ftp_family FTPS_DESTINATIONS ftps
  cleanup_remote_sftp
fi

log "Cleanup complete."

retry_upload() {
  local host="$1" file="$2" type="$3"
  shift 3
  local -a cmd_args=("$@")
  local attempt=1 success=false

  while [ $attempt -le 3 ]; do
    log "→ Attempt $attempt for $type upload ($host): $(basename "$file")"
    if "${cmd_args[@]}"; then
      log "✅ $type upload succeeded on attempt $attempt ($host)"
      success=true
      break
    else
      log "⚠️ $type upload failed on attempt $attempt ($host)"
      ((attempt++))
      [ $attempt -le 3 ] && sleep 30
    fi
  done

  if [ "$success" = false ]; then
    log "❌ $type upload permanently failed for $host"
    FAILED_TARGETS+=("$type → $host")
  fi
}

upload_ftp_multi() {
  [ "${#FTP_DESTINATIONS[@]}" -eq 0 ] && return
  log "Uploading to FTP destinations..."
  local dest host user pass path file
  for dest in "${FTP_DESTINATIONS[@]}"; do
    IFS='|' read -r host user pass path <<< "$dest"
    for file in "$BACKUP_DIR"/*; do
      [[ "$file" == *.log ]] && continue
      retry_upload "$host" "$file" "FTP" \
        curl -s -T "$file" --user "$user:$pass" "ftp://$host/$path/$DATE/" --ftp-create-dirs
    done
  done
}

upload_ftps_multi() {
  [ "${#FTPS_DESTINATIONS[@]}" -eq 0 ] && return
  log "Uploading to FTPS destinations..."
  local dest host user pass path file
  for dest in "${FTPS_DESTINATIONS[@]}"; do
    IFS='|' read -r host user pass path <<< "$dest"
    for file in "$BACKUP_DIR"/*; do
      [[ "$file" == *.log ]] && continue
      retry_upload "$host" "$file" "FTPS" \
        curl -s -T "$file" --user "$user:$pass" "ftps://$host/$path/$DATE/" --ftp-create-dirs --ssl
    done
  done
}

upload_sftp_multi() {
  [ "${#SFTP_DESTINATIONS[@]}" -eq 0 ] && return
  log "Uploading to SFTP destinations..."
  local dest host user pass path file
  for dest in "${SFTP_DESTINATIONS[@]}"; do
    IFS='|' read -r host user pass path <<< "$dest"
    for file in "$BACKUP_DIR"/*; do
      [[ "$file" == *.log ]] && continue
      retry_upload "$host" "$file" "SFTP" \
        sshpass -p "$pass" scp -q -o StrictHostKeyChecking=no "$file" "$user@$host:$path/$DATE/"
    done
  done
}

if [ "$UPLOAD_ENABLED" = "true" ]; then
  upload_ftp_multi
  upload_ftps_multi
  upload_sftp_multi

  if [ "${#FTP_DESTINATIONS[@]}" -eq 0 ] && [ "${#FTPS_DESTINATIONS[@]}" -eq 0 ] && [ "${#SFTP_DESTINATIONS[@]}" -eq 0 ]; then
    log "🚫 No upload destinations configured"
  fi
else
  log "🚫 Upload disabled (local backup only)"
fi

END_TIME=$(date +%s)
DURATION=$((END_TIME - START_TIME))
MINUTES=$((DURATION / 60))
SECONDS=$((DURATION % 60))
BACKUP_SIZE=$(du -sh "$BACKUP_DIR" 2>/dev/null | cut -f1)
END_DATETIME_DISPLAY=$(date '+%Y-%m-%d %H:%M')

if [ $ERROR_COUNT -gt 0 ]; then
  SUMMARY="⚠️ <b>Backup completed with ${ERROR_COUNT} error(s)</b>\n🕒 Duration: ${MINUTES}m ${SECONDS}s\n📦 Size: ${BACKUP_SIZE}\n📅 Date: $END_DATETIME_DISPLAY\n\n$ERROR_LOG"
  log "⚠️ Backup completed with ${ERROR_COUNT} errors."
else
  SUMMARY="✅ <b>MySQL Backup Completed Successfully</b>\n🕒 Duration: ${MINUTES}m ${SECONDS}s\n📦 Size: ${BACKUP_SIZE}\n📅 Date: $END_DATETIME_DISPLAY"
  log "✅ MySQL backup process completed successfully in ${MINUTES}m ${SECONDS}s (size: ${BACKUP_SIZE})"
fi

if [ ${#FAILED_TARGETS[@]} -gt 0 ]; then
  FAIL_MSG="\n\n🚨 <b>Failed Upload Destinations:</b>\n"
  for target in "${FAILED_TARGETS[@]}"; do
    FAIL_MSG+="• $target\n"
  done
  log "⚠️ Upload failed for one or more destinations."
  FINAL_MESSAGE="${SUMMARY}${FAIL_MSG}"
else
  FINAL_MESSAGE="$SUMMARY"
fi

if [ "$TELEGRAM_ENABLED" = "true" ]; then
  send_telegram_message "$FINAL_MESSAGE" &
  send_telegram_file "📄 Backup log file for $(hostname) ($DATE)" &
fi

wait
log "=== Backup script finished ==="
chmod 600 "$LOG_FILE"
exit 0
